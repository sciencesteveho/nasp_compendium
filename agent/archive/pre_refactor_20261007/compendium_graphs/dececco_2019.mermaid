  n1 -- produces --> n12
  %% activates; canonical_inferred; DeCecco_nature_2019
  n12 -- activates --> n10
  %% drives; perturbation_supported; DeCecco_nature_2019
  n10 -- drives --> n19
  %% activates; direct_measured; DeCecco_nature_2019
  n19 -- activates --> n5
  %% drives; perturbation_supported; DeCecco_nature_2019
  n5 -- drives --> n9
