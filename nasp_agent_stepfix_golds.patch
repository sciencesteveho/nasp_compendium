-    for group_index, (anchor, leaves) in enumerate(sorted(rank_groups.items())):
-        with diagram.subgraph(name=f"compact_leaf_rank_{group_index}") as group:  # type: ignore
-            group.attr(rank="same")
-            group.node(anchor)
-            for leaf in leaves:
-                group.node(leaf)
