---
config:
  fontFamily: Arial
  theme: base
  themeCSS: ".nodeLabel,.nodeLabel *,.edgeLabel,.edgeLabel *{font-family:Arial!important;font-size:5pt!important;}"
  flowchart:
    curve: basis
    nodeSpacing: 24
    rankSpacing: 36
  themeVariables:
    fontFamily: Arial
    fontSize: 5pt
---
flowchart LR
  n0["CCL2"]:::genes
  n1["CGAS"]:::nucleic_acid_sensors
  n2["FOXA1"]:::genes
  n3["IL1B"]:::genes
  n4["IL6"]:::genes
  n5["JAK-STAT"]:::pathways
  n6["MMP3"]:::genes
  n7["RB1"]:::genes
