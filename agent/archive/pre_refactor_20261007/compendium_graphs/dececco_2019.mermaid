  %% upregulates; perturbation_supported; DeCecco_nature_2019
  n10 -- upregulates --> n6
  %% upregulates; perturbation_supported; DeCecco_nature_2019
  n5 -- upregulates --> n4
  %% upregulates; perturbation_supported; DeCecco_nature_2019
  n5 -- upregulates --> n0
  %% upregulates; perturbation_supported; DeCecco_nature_2019
  n5 -- upregulates --> n6
  %% induces; direct_measured; DeCecco_nature_2019
  n13 -- induces --> n17
  %% drives; perturbation_supported; DeCecco_nature_2019
  n17 -- drives --> n19
  %% drives; perturbation_supported; DeCecco_nature_2019
  n9 -- drives --> n16
  %% drives; perturbation_supported; DeCecco_nature_2019
  n16 -- drives --> n18
  %% does_not_correlate; direct_measured; DeCecco_nature_2019
  n13 -- does not correlate --- n8
  %% required_for; perturbation_supported; DeCecco_nature_2019
  n17 -- required for --> n19
  %% does_not_drive; perturbation_supported; DeCecco_nature_2019
  n19 -- does not drive --- n3

