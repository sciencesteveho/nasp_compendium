-        if directions is None:
-            return None
-
-        normalized = {direction.strip().lower() for direction in directions}
-        if invalid := normalized.difference(
-            {"positive", "inverse", "context_dependent"}
-        ):
-            invalid_text = ", ".join(sorted(invalid))
