-            strict=strict,
-        )
-
-        positive_genes, missing_positive_genes = self._genes_by_direction(
-            validation=validation,
-            direction="positive",
-            output=resolved_output,
-            adata=adata,
-        )
-        inverse_genes, missing_inverse_genes = self._genes_by_direction(
