---
config:
  fontFamily: Arial
  theme: base
  themeCSS: ".nodeLabel,.nodeLabel *,.edgeLabel,.edgeLabel *{font-family:Arial!important;font-size:5pt!important;}"
  flowchart:
    curve: basis
    nodeSpacing: 24
    rankSpacing: 36
  themeVariables:
    fontFamily: Arial
    fontSize: 5pt
---
flowchart LR
  n0["CGAS"]:::nucleic_acid_sensors
  n1["IL6"]:::genes
  n2["IRF3"]:::genes
  n3["NF-kB"]:::pathways
  n4["PRMT5"]:::genes
  n5["STING1"]:::nucleic_acid_sensors
  n6["TBK1"]:::genes
  n7["TNF"]:::genes
  n8["cGAMP"]:::default
  n9["cytosolic dsDNA"]:::mechanisms
  n10["type I IFN"]:::pathways
  %% binds_recruits; direct_measured; Ma_sciadv_2021
  n4 -- binds recruits --> n0
  %% inhibits; direct_measured; Ma_sciadv_2021
  n4 -- inhibits --x n0
  %% binds_recruits; perturbation_supported; Ma_sciadv_2021
  n9 -- binds recruits --> n0
  %% produces; perturbation_supported; Ma_sciadv_2021
  n0 -- produces --> n8
  %% activates; canonical_inferred; Ma_sciadv_2021
  n8 -- activates --> n5
  %% activates; perturbation_supported; Ma_sciadv_2021
  n5 -- activates --> n6
  %% activates; perturbation_supported; Ma_sciadv_2021
  n6 -- activates --> n2
  %% drives; direct_measured; Ma_sciadv_2021
  n2 -- drives --> n10
  %% activates; perturbation_supported; Ma_sciadv_2021
  n5 -- activates --> n3
  %% drives; perturbation_supported; Ma_sciadv_2021
  n3 -- drives --> n7
  %% drives; perturbation_supported; Ma_sciadv_2021
  n3 -- drives --> n1
  %% does_not_drive; perturbation_supported; Ma_sciadv_2021
  n4 -- does not drive --- n5
  %% suppresses; direct_measured; Ma_sciadv_2021
  n4 -- suppresses --x n10

  classDef default fill:#F2F2F2,stroke:#666666,color:#111111,font-family:Arial,font-size:5pt;
  classDef cell_types fill:#FADBD8,stroke:#C44E52,color:#111111,font-family:Arial,font-size:5pt;
  classDef evidence_type fill:#EAEDED,stroke:#937860,color:#111111,font-family:Arial,font-size:5pt;
  classDef genes fill:#DCE6F2,stroke:#4C72B0,color:#111111,font-family:Arial,font-size:5pt;
  classDef mechanisms fill:#E2EFDA,stroke:#55A868,color:#111111,font-family:Arial,font-size:5pt;
  classDef model_systems fill:#E8DAEF,stroke:#8172B3,color:#111111,font-family:Arial,font-size:5pt;
  classDef nucleic_acid_sensors fill:#FFF2CC,stroke:#B45F06,color:#111111,font-family:Arial,font-size:5pt;
  classDef pathways fill:#FCE4D6,stroke:#DD8452,color:#111111,font-family:Arial,font-size:5pt;
  linkStyle 0 stroke:#8172B3,stroke-width:1px;
  linkStyle 1 stroke:#C44E52,stroke-width:1px;
  linkStyle 2 stroke:#8172B3,stroke-width:1px;
  linkStyle 3 stroke:#4C72B0,stroke-width:1px;
  linkStyle 4 stroke:#55A868,stroke-width:1px,stroke-dasharray:5 3;
  linkStyle 5 stroke:#55A868,stroke-width:1px;
  linkStyle 6 stroke:#55A868,stroke-width:1px;
  linkStyle 7 stroke:#55A868,stroke-width:1px;
  linkStyle 8 stroke:#55A868,stroke-width:1px;
  linkStyle 9 stroke:#55A868,stroke-width:1px;
  linkStyle 10 stroke:#55A868,stroke-width:1px;
  linkStyle 11 stroke:#CCCCCC,stroke-width:1px;
  linkStyle 12 stroke:#C44E52,stroke-width:1px;
