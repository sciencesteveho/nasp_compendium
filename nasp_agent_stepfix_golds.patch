+def _tagged_edge(
+    source: str,
+    target: str,
+    rel: str = "activates",
+    evidence: str = "direct_measured",
+    **extra: str,
+) -> str:
+    """Return one edge block plus optional tier/equiv_group/status lines."""
+    block = _edge(source, target, rel, evidence).rstrip("\n")
+    for key, value in extra.items():
+        block += f"\n        {key}: {value}"
+    return block + "\n"
+
