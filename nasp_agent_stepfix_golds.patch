-def _deduplicate_paths(paths: Iterable[Path]) -> list[Path]:
-    """Return paths in first-seen order without duplicates."""
-    seen: set[Path] = set()
-    unique_paths: list[Path] = []
-    for path in paths:
-        expanded = path.expanduser()
-        if expanded in seen:
-            continue
-        seen.add(expanded)
-        unique_paths.append(expanded)
-    return unique_paths
